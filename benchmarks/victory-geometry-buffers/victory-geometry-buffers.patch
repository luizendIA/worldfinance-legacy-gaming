diff --git a/crates/victory-shader/src/emit/mesh_capture.rs b/crates/victory-shader/src/emit/mesh_capture.rs
new file mode 100644
index 0000000..9a42b5d
--- /dev/null
+++ b/crates/victory-shader/src/emit/mesh_capture.rs
@@ -0,0 +1,46 @@
+//! Geometry buffer output for a resource-free synthetic mesh shader.
+//! The upstream synthetic triangle uses exp pos0 and exp prim in each lane.
+
+use super::{container, lower};
+use crate::native::{HwStage, MeshIo, NativeProgram, StageIo};
+use crate::{ShaderError, io, ir, resource, structure};
+
+/// Builds the standalone Polaris test shader from original synthetic GFX10 instructions.
+/// One 32-lane group writes float4 positions at u0 and uint3 indices at u1, both in space 1.
+pub fn synthetic_triangle(culled: bool) -> Result<Vec<u8>, ShaderError> {
+    let primitive = (1 << 10) | (2 << 20) | (1 << 9) | (1 << 19) | (1 << 29)
+        | (u32::from(culled) << 31);
+    // Same synthetic instruction sequence as primitive_export_indices_drop_the_edge_flags.
+    let words = [
+        0xD765_0001u32, 0x0001_00C1, 0x3604_0281, 0x3606_0282, 0x7E04_0D02,
+        0x7E06_0D03, 0x1008_04F6, 0x0608_08F3, 0x100A_06F4, 0x060A_0AF3,
+        0x7E0C_02F0, 0x7E0E_02F2, 0x7E12_02FF, primitive, 0xF800_0941, 9,
+        0xF800_08CF, 0x0706_0504, 0xBF81_0000,
+    ];
+    let native = NativeProgram {
+        stage: HwStage::Ms,
+        wave64: false,
+        vgprs: 10,
+        layout: vec![],
+        used: vec![],
+        io: StageIo::Ms(MeshIo {
+            outputs: vec![], clip_cntl: 0, threads: 32, max_vertices: 32,
+            max_primitives: 32, topology: 2, lds_bytes: 0,
+        }),
+        code: words.iter().flat_map(|w| w.to_le_bytes()).collect(),
+    };
+    let position = container::SigElement {
+        name: "SV_Position".into(), index: 0, kind: 3, comp: 9, interp: 0,
+        row: Some(0), col: 0, cols: 4, usage: 0xF, half: false,
+    };
+    let p = ir::build(&native.patched_code(), native.wave64, native.vgprs)?;
+    let st = structure::structure(&p)?;
+    let res = resource::track(&p, &native.layout, native.stage, Some(&st))?;
+    let io = io::raise(&p, &native)?;
+    let parts = lower::Parts {
+        native: &native, p: &p, st: &st, io: &io, res: &res, inputs: vec![],
+        outputs: vec![position],
+        prims: vec![], mesh_stride: 32, view_marks: false,
+    };
+    lower::lower_capture(&parts).map(|l| l.dxil)
+}
