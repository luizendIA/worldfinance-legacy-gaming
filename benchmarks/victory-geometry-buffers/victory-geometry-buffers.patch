index 0000000..d83fb7a
--- /dev/null
+++ b/crates/victory-shader/examples/export_polaris.rs
@@ -0,0 +1,10 @@
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let path = std::env::args_os().nth(1).ok_or("Usage: export_polaris NEW_DIRECTORY")?;
+    let dir = std::path::PathBuf::from(path);
+    std::fs::create_dir(&dir)?;
+    for (name, culled) in [("visible.dxil", false), ("culled.dxil", true)] {
+        let shader = victory_shader::emit::mesh_capture::synthetic_triangle(culled)?;
+        std::fs::write(dir.join(name), shader)?;
+    }
+    Ok(())
+}
